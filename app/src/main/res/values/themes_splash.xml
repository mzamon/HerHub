<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: HerHub gradient shows instantly, no white flash before the animated splash. -->
    <style name="Theme.HerHub.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
